MEXC_API_KEY=
MEXC_API_SECRET=
LIVE_TRADING_ENABLED=0
# Extra gate: live CLI also requires LIVE_VERIFIED=1 after MexcBroker VERIFY audit.
LIVE_VERIFIED=0
# Log intended MEXC orders without sending (CI / rehearsal). Keep 1 until broker verified.
MEXC_DRY_RUN=1
# Backtest circuit-breaker pause after DD/expectancy trip (hours). Live stays permanent.
KILL_RESUME_HOURS=168

# Hunt/autopilot research prices (live/paper still use MEXC).
# binance_spot = deep USDT history · mexc = same venue as live
HUNT_PRICE_SOURCE=binance_spot

STARTING_EQUITY=50.0
# Hunt/research backtests only — paper Live keeps STARTING_EQUITY.
RESEARCH_STARTING_EQUITY=50.0
LEVERAGE=5
MAX_ACCOUNT_LEVERAGE=5
ENABLE_PYRAMIDING=1
ENABLE_PARTIAL=0
ADX_ENTER=28
ADX_EXIT=22
VOLUME_MULTIPLIER=1.8
BREAKOUT_BUFFER_ATR=0.15
BREAKOUT_LOOKBACK=18
TRAIL_ATR=2.0
COOLDOWN_BARS=4
REQUIRE_RISING_ADX=1
REQUIRE_SQUEEZE=0
REQUIRE_BTC_REGIME=1
# Momentum15 HTF gates (0=off; hunt can flip these)
REQUIRE_H4_BIAS=0
REQUIRE_DAILY_ALIGN=0
REQUIRE_WEEKLY_BIAS=0
EMA_WEEKLY_PERIOD=10
AGGRESSIVE_MODE=0
LOG_LEVEL=INFO
